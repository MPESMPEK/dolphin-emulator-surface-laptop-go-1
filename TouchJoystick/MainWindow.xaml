<Window x:Class="TouchJoystick.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Surface Gaming Suite v2.0"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid x:Name="RootGrid">
        <!-- ══════════════════════════════════════════════════ -->
        <!-- VIEW 1: MULTI-EMULATOR HUB (LAUNCHER UI)          -->
        <!-- ══════════════════════════════════════════════════ -->
        <Grid x:Name="HubContainer" Background="#0F1117" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#161922" BorderBrush="#252A38" BorderThickness="0,0,0,1" Padding="25,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎮" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SURFACE GAMING HUB" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="v2.0.0 • Edisi Khusus Layar Sentuh &amp; Intel UHD Ice Lake" Foreground="#8E9AA8" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Battery Status Pill & Exit -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="HubBatteryPill" Background="#1E2330" CornerRadius="15" Padding="14,6" Margin="0,0,15,0" BorderBrush="#2F3648" BorderThickness="1">
                            <TextBlock x:Name="HubBatteryText" Text="⚡ Memeriksa Daya..." Foreground="#00E5FF" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Button x:Name="BtnCloseHub" Content="✕" Width="36" Height="36" Background="#262B3B" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="BtnCloseHub_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hub Content (Cards Grid) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="25">
                <StackPanel>
                    <TextBlock Text="PILIH EMULATOR" Foreground="#6C7A8E" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>

                    <WrapPanel Orientation="Horizontal">
                        <!-- Card: DOLPHIN (Primary) -->
                        <Border Width="280" Height="200" Background="#191D28" BorderBrush="#00E5FF" BorderThickness="2" CornerRadius="16" Margin="0,0,20,20" Cursor="Hand" MouseDown="LaunchDolphin_Click">
                            <Grid Margin="18">
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="🐬" FontSize="36" Margin="0,0,0,6"/>
                                    <TextBlock Text="Dolphin Emulator" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Nintendo GameCube &amp; Wii" Foreground="#00E5FF" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Optimal 1536x1024 3:2, Direct3D 12, AVX2 Ice Lake." Foreground="#8A96A6" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Background="#00E5FF" CornerRadius="8" Padding="10,6" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <TextBlock Text="MAIN SEKARANG ▶" Foreground="#0A0D14" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card: PCSX2 (PS2) -->
                        <Border Width="280" Height="200" Background="#161922" BorderBrush="#252A38" BorderThickness="1" CornerRadius="16" Margin="0,0,20,20" Cursor="Hand" MouseDown="LaunchPcsx2_Click">
                            <Grid Margin="18">
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="🎮" FontSize="36" Margin="0,0,0,6"/>
                                    <TextBlock Text="PCSX2" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Sony PlayStation 2" Foreground="#7986CB" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Emulasi PS2 dengan overlay kontrol DualShock virtual." Foreground="#8A96A6" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Background="#252A38" CornerRadius="8" Padding="10,6" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <TextBlock Text="BUKA / SCAN 🔍" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card: DuckStation (PS1) -->
                        <Border Width="280" Height="200" Background="#161922" BorderBrush="#252A38" BorderThickness="1" CornerRadius="16" Margin="0,0,20,20" Cursor="Hand" MouseDown="LaunchDuckStation_Click">
                            <Grid Margin="18">
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="🦆" FontSize="36" Margin="0,0,0,6"/>
                                    <TextBlock Text="DuckStation" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Sony PlayStation 1" Foreground="#FFB74D" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Emulasi PS1 super ringan, PGXP koreksi tekstur presisi." Foreground="#8A96A6" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Background="#252A38" CornerRadius="8" Padding="10,6" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <TextBlock Text="BUKA / SCAN 🔍" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card: PPSSPP (PSP) -->
                        <Border Width="280" Height="200" Background="#161922" BorderBrush="#252A38" BorderThickness="1" CornerRadius="16" Margin="0,0,20,20" Cursor="Hand" MouseDown="LaunchPpsspp_Click">
                            <Grid Margin="18">
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="🏎️" FontSize="36" Margin="0,0,0,6"/>
                                    <TextBlock Text="PPSSPP" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="PlayStation Portable" Foreground="#4DD0E1" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Game PSP 60 FPS sangat mulus di GPU Intel UHD Gen 11." Foreground="#8A96A6" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Background="#252A38" CornerRadius="8" Padding="10,6" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <TextBlock Text="BUKA / SCAN 🔍" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card: RetroArch (Multi-System) -->
                        <Border Width="280" Height="200" Background="#161922" BorderBrush="#252A38" BorderThickness="1" CornerRadius="16" Margin="0,0,20,20" Cursor="Hand" MouseDown="LaunchRetroArch_Click">
                            <Grid Margin="18">
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="🕹️" FontSize="36" Margin="0,0,0,6"/>
                                    <TextBlock Text="RetroArch" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="GBA, SNES, Genesis &amp; Arcade" Foreground="#BA68C8" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Pusat game klasik retro all-in-one dengan joystick sentuh." Foreground="#8A96A6" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Background="#252A38" CornerRadius="8" Padding="10,6" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <TextBlock Text="BUKA / SCAN 🔍" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#161922" BorderBrush="#252A38" BorderThickness="0,1,0,0" Padding="25,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="💡 Tip: Klik Dolphin untuk langsung mulai bermain dengan layar sentuh." Foreground="#6C7A8E" FontSize="12" VerticalAlignment="Center"/>
                    <Button Content="Mode Joystick Layar Penuh Saja" HorizontalAlignment="Right" Background="#262B3B" Foreground="#00E5FF" BorderThickness="0" Padding="15,8" Cursor="Hand" Click="BtnStartOverlayOnly_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- VIEW 2: IN-GAME OVERLAY (TOUCH CONTROLLER + BAR)  -->
        <!-- ══════════════════════════════════════════════════ -->
        <Canvas x:Name="OverlayCanvas" Background="Transparent" IsHitTestVisible="True" ClipToBounds="True" Visibility="Collapsed">
            
            <!-- Quick Touch GameBar (Floating at Top) -->
            <Border x:Name="GameBar" Canvas.Top="10" Canvas.Left="100" Height="40" Background="#C812151E" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="20" Padding="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleControls" Content="🎮 Kontrol" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="12" FontWeight="SemiBold" Margin="4,0" Cursor="Hand" Click="BtnToggleControls_Click"/>
                    <Border Width="1" Height="18" Background="#30FFFFFF" Margin="4,0"/>
                    <Button x:Name="BtnSaveState" Content="💾 Simpan (F1)" Background="Transparent" Foreground="#00E5FF" BorderThickness="0" FontSize="12" Margin="4,0" Cursor="Hand" Click="BtnSaveState_Click"/>
                    <Button x:Name="BtnLoadState" Content="📂 Muat (F8)" Background="Transparent" Foreground="#FFD54F" BorderThickness="0" FontSize="12" Margin="4,0" Cursor="Hand" Click="BtnLoadState_Click"/>
                    <Button x:Name="BtnTurbo" Content="⏩ Turbo" Background="Transparent" Foreground="#81C784" BorderThickness="0" FontSize="12" Margin="4,0" Cursor="Hand" Click="BtnTurbo_Click"/>
                    <Border Width="1" Height="18" Background="#30FFFFFF" Margin="4,0"/>
                    <Button x:Name="BtnSettingsDrawer" Content="⚙ Menu" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="12" Margin="4,0" Cursor="Hand" Click="BtnSettingsDrawer_Click"/>
                    <Border Width="1" Height="18" Background="#30FFFFFF" Margin="4,0"/>
                    <Button x:Name="BtnBackToHub" Content="🏠 Hub" Background="Transparent" Foreground="#FF8A80" BorderThickness="0" FontSize="12" Margin="4,0" Cursor="Hand" Click="BtnBackToHub_Click"/>
                </StackPanel>
            </Border>

            <!-- Quick Settings Drawer (Popup) -->
            <Border x:Name="SettingsDrawer" Canvas.Top="55" Canvas.Left="150" Width="320" Background="#E6161922" BorderBrush="#00E5FF" BorderThickness="1.5" CornerRadius="16" Padding="18" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="PENGATURAN KONTROL SENTUH" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- Layout Presets -->
                    <TextBlock Text="Preset Tata Letak Tombol:" Foreground="#90A4AE" FontSize="11" Margin="0,0,0,6"/>
                    <UniformGrid Columns="3" Margin="0,0,0,15">
                        <Button x:Name="BtnLayoutGC" Content="GameCube" Background="#00E5FF" Foreground="#0F1117" FontWeight="Bold" FontSize="11" Height="30" Margin="2" Click="SetLayoutGC_Click"/>
                        <Button x:Name="BtnLayoutWii" Content="Wii Remote" Background="#262B3B" Foreground="#FFFFFF" FontSize="11" Height="30" Margin="2" Click="SetLayoutWii_Click"/>
                        <Button x:Name="BtnLayoutPS" Content="PlayStation" Background="#262B3B" Foreground="#FFFFFF" FontSize="11" Height="30" Margin="2" Click="SetLayoutPS_Click"/>
                    </UniformGrid>

                    <!-- Opacity Slider -->
                    <TextBlock x:Name="TxtOpacity" Text="Transparansi Tombol: 60%" Foreground="#90A4AE" FontSize="11" Margin="0,0,0,4"/>
                    <Slider x:Name="SliderOpacity" Minimum="0.2" Maximum="1.0" Value="0.6" Margin="0,0,0,15" ValueChanged="SliderOpacity_ValueChanged"/>

                    <!-- Scale Slider -->
                    <TextBlock x:Name="TxtScale" Text="Ukuran Tombol: 100%" Foreground="#90A4AE" FontSize="11" Margin="0,0,0,4"/>
                    <Slider x:Name="SliderScale" Minimum="0.8" Maximum="1.4" Value="1.0" Margin="0,0,0,15" ValueChanged="SliderScale_ValueChanged"/>

                    <!-- Battery Status -->
                    <Border Background="#1E2330" CornerRadius="8" Padding="10,6">
                        <TextBlock x:Name="TxtOverlayBattery" Text="⚡ Mode Daya: Mengoptimalkan..." Foreground="#00E5FF" FontSize="11"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Controller Canvas (Dynamic buttons rendered here) -->
            <Canvas x:Name="ControllerCanvas" Background="Transparent" IsHitTestVisible="True" ClipToBounds="True"/>
        </Canvas>
    </Grid>
</Window>
